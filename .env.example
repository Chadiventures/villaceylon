NEXT_PUBLIC_SITE_URL=https://thepapayatree.com
ANTHROPIC_API_KEY=

# Booking provider. Leave unset (or "whatsapp") to keep using the WhatsApp fallback in
# lib/booking.ts. Set to "beds24" once lib/booking/beds24.ts is wired up for real; the
# UI does not need to change either way.
BOOKING_MODE=

# Beds24 channel manager (see lib/booking/beds24.ts). All three are required before
# BOOKING_MODE=beds24 will work.
BEDS24_API_KEY=
BEDS24_PROPERTY_ID=
# Comma separated map of our room ids (lib/rooms.ts) to Beds24 room ids, e.g.
# "double:111222,family:111223"
BEDS24_ROOM_IDS=
